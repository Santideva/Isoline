// ══════════════════════════════════════════════════════════════════════════════
// MT-PARAMS-EXPORT v2 — Node Parameter and Export Test Suite
// ══════════════════════════════════════════════════════════════════════════════
//
// What this test verifies:
//   1.  Every geometry, transform, and blend node exposes the correct param
//       keys — these are the keys that appear as controls on NodeCards.
//   2.  Updating any param via updateNodeParam persists the new value.
//   3.  Calling _onParamChange invalidates the GLSL shader cache.
//   4.  Geometry primitives: changing a size/position param changes the SDF
//       value at a probe point (CPU usability check).
//   5.  Transform nodes: changing a key param produces a different compiled
//       GLSL shader source (GLSL usability check — confirms the param value
//       is embedded in generated code, not silently ignored).
//   6.  Blend nodes: changing smoothness produces both a different GLSL source
//       AND a different CPU SDF value at the blend boundary.
//   7.  rIntersection and rDifference produce geometrically correct SDF signs.
//   8.  Export methods (PNG canvas, GLSL shader, JSON) produce valid output.
//
// Run: paste into browser console after the app has loaded.
// Requires: window._nodeCanvas, window._stateStore, window._sceneManager
// ══════════════════════════════════════════════════════════════════════════════

(async function MT_PARAMS_EXPORT_V2() {

const nc = window._nodeCanvas;
const ss = window._stateStore;
const sm = window._sceneManager;

if (!nc || !ss || !sm) {
    console.error(
        'MT-PARAMS-EXPORT-V2: Required globals not found.\n' +
        'Ensure window._nodeCanvas, _stateStore, _sceneManager are exposed in index.js.'
    );
    return;
}

// ── Test harness ──────────────────────────────────────────────────────────────

let passed = 0, failed = 0;
const failures = [];

function check(name, condition, detail = '') {
    if (condition) {
        passed++;
        console.log(`  ✓  ${name}`);
    } else {
        failed++;
        const msg = detail ? `${name} — ${detail}` : name;
        failures.push(msg);
        console.error(`  ✗  ${msg}`);
    }
}

function section(title)  { console.group(`\n▶ ${title}`); }
function sectionEnd()    { console.groupEnd(); }

const wait  = ms => new Promise(r => setTimeout(r, ms));
const graph = ()  => ss.nodeGraph;

function clearScene() {
    if (sm.currentSchur) { sm._removeFromScene(sm.currentSchur); sm.currentSchur = null; }
    sm.activePrimitives.forEach(p => sm._removeFromScene(p));
    sm.activePrimitives    = [];
    ss.clear();
    sm.evaluator.graph     = graph();
    sm.evaluator.invalidate();
    sm.glslEvaluator.graph = graph();
    sm._lastGLSLSource     = null;
    sm._lastRayMarchSource = null;
}

function findNode(pred) {
    let found = null;
    graph().nodes.forEach(n => { if (!found && pred(n)) found = n; });
    return found;
}

function checkParams(label, node, expectedKeys) {
    if (!node) { check(`[${label}] node exists`, false, 'node is null'); return null; }
    check(`[${label}] node exists`, true);
    const actual = Object.keys(node.params || {});
    for (const key of expectedKeys) {
        check(
            `[${label}] param "${key}" present`,
            key in (node.params || {}),
            key in (node.params || {}) ? '' : `MISSING — actual keys: [${actual.join(', ')}]`
        );
    }
    return node;
}

function checkParamUpdate(label, nodeId, paramName, newValue) {
    graph().updateNodeParam(nodeId, paramName, newValue);
    const stored = graph().nodes.get(nodeId)?.params[paramName];
    check(
        `[${label}] "${paramName}" update persists`,
        stored === newValue,
        stored === newValue ? '' : `stored ${stored}, expected ${newValue}`
    );
    sm._lastGLSLSource = '__SENTINEL__';
    nc._onParamChange(nodeId, paramName, newValue);
    check(
        `[${label}] "${paramName}" change invalidates GLSL cache`,
        sm._lastGLSLSource === null,
        sm._lastGLSLSource === null ? '' : 'cache NOT cleared'
    );
}

function wireAndGetSDF(nodeId, outPort = 'sdf') {
    const out = sm._ensureOutputNode();
    try { graph().addEdge(nodeId, outPort, out.id, 'sdf'); } catch (_) {}
    sm.evaluator.graph = graph();
    sm.evaluator.invalidate();
    try { return sm.evaluator.getRootSDF(); } catch (_) { return null; }
}

// Verify changing a numeric param alters the SDF at a probe point.
function checkSDFChanges(label, nodeId, paramName, v0, v1, probe) {
    graph().updateNodeParam(nodeId, paramName, v0);
    sm.evaluator.graph = graph(); sm.evaluator.invalidate();
    let sdf0 = null;
    try { sdf0 = sm.evaluator.getRootSDF(); } catch (_) {}
    const val0 = sdf0?.(probe);

    graph().updateNodeParam(nodeId, paramName, v1);
    sm.evaluator.graph = graph(); sm.evaluator.invalidate();
    let sdf1 = null;
    try { sdf1 = sm.evaluator.getRootSDF(); } catch (_) {}
    const val1 = sdf1?.(probe);

    check(
        `[${label}] "${paramName}" change alters SDF at probe (CPU usability)`,
        isFinite(val0) && isFinite(val1) && Math.abs(val1 - val0) > 1e-6,
        `before=${val0?.toFixed(4)}  after=${val1?.toFixed(4)}`
    );
}

// Verify changing a param produces a different compiled GLSL shader source.
// This confirms the param value is embedded in generated code, not ignored.
async function checkGLSLSourceChanges(label, nodeId, paramName, v0, v1) {
    graph().updateNodeParam(nodeId, paramName, v0);
    sm._lastGLSLSource = null;
    sm._renderGLSL();
    await wait(300);
    const src0 = sm._lastGLSLSource;

    graph().updateNodeParam(nodeId, paramName, v1);
    nc._onParamChange(nodeId, paramName, v1);
    sm._lastGLSLSource = null;
    sm._renderGLSL();
    await wait(300);
    const src1 = sm._lastGLSLSource;

    check(
        `[${label}] "${paramName}" change alters GLSL source (shader usability)`,
        !!src0 && !!src1 && src0 !== src1,
        !src0 ? 'initial GLSL source was null — scene may not be wired'
              : src0 === src1 ? 'GLSL source identical after param change — param may not be embedded as a literal'
              : ''
    );
}

const wire = (f, fp, t, tp) => { try { graph().addEdge(f, fp, t, tp); } catch (_) {} };

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 1 — 2D Geometry Primitive Parameters
// ══════════════════════════════════════════════════════════════════════════════
section('Section 1 — 2D Geometry Primitive Parameters');

// ── lineSegment: params confirmed x1, y1, x2, y2 ─────────────────────────────
{
    clearScene();
    sm.addPrimitive('line');
    await wait(80);
    const lineNode = findNode(n => n.type === 'lineSegment');
    checkParams('line', lineNode, ['x1', 'y1', 'x2', 'y2']);
    if (lineNode) {
        checkParamUpdate('line', lineNode.id, 'x2', 3.0);
        clearScene();
        sm.addPrimitive('line');
        await wait(60);
        const n2 = findNode(n => n.type === 'lineSegment');
        if (n2) {
            const sdf = wireAndGetSDF(n2.id, 'sdf');
            if (sdf) checkSDFChanges('line', n2.id, 'x2', 0.5, 3.0, { x: 2.0, y: 0.5, z: 0 });
            else check('[line] SDF obtainable', false, 'getRootSDF returned null');
        }
    }
}

const PRIMS_2D = [
    ['triangle', 'triangle',
        ['size', 'rotation', 'posX', 'posY', 'cornerRounding'],
        ['size', 2.5],
        ['size', 0.5, 2.5, { x: 0, y: 0, z: 0 }]],

    ['arc', 'arc',
        ['radius', 'startAngle', 'endAngle', 'segments', 'posX', 'posY'],
        ['radius', 2.5],
        ['radius', 1.0, 2.5, { x: 1.5, y: 0, z: 0 }]],

    ['circle', 'circle',
        ['radius', 'posX', 'posY'],
        ['radius', 2.0],
        ['radius', 1.0, 3.0, { x: 2.0, y: 0, z: 0 }]],

    ['polygon', 'regularPolygon',
        // circumradius stored as 'size' — V2 will unify with 'radius'
        ['sides', 'size', 'rotation', 'posX', 'posY'],
        ['size', 2.0],
        ['size', 0.5, 2.5, { x: 0, y: 0, z: 0 }]],

    ['polytope', 'polytope',
        ['vertices', 'posX', 'posY', 'rotation'],
        ['posX', 1.5],
        ['posX', 0.0, 4.0, { x: 0, y: 0, z: 0 }]],
];

for (const [addType, nodeType, expectedKeys, [updateParam, updateVal], [sdfParam, v0, v1, probe]]
    of PRIMS_2D) {
    clearScene();
    sm.addPrimitive(addType);
    await wait(80);
    const node = findNode(n => n.type === nodeType);
    checkParams(addType, node, expectedKeys);
    if (node) {
        checkParamUpdate(addType, node.id, updateParam, updateVal);
        clearScene();
        sm.addPrimitive(addType);
        await wait(60);
        const node2 = findNode(n => n.type === nodeType);
        if (node2) {
            const sdf = wireAndGetSDF(node2.id, 'sdf');
            if (sdf) checkSDFChanges(addType, node2.id, sdfParam, v0, v1, probe);
            else check(`[${addType}] SDF obtainable`, false, 'getRootSDF returned null');
        }
    }
}

sectionEnd();

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 2 — 3D Geometry Primitive Parameters
// ══════════════════════════════════════════════════════════════════════════════
section('Section 2 — 3D Geometry Primitive Parameters');

const PRIMS_3D = [
    ['sphere', 'sphere',
        ['radius', 'posX', 'posY', 'posZ'],
        ['radius', 2.0],
        ['radius', 1.0, 3.0, { x: 2.0, y: 0, z: 0 }]],

    ['box', 'box',
        ['width', 'height', 'depth', 'posX', 'posY', 'posZ'],
        ['width', 3.0],
        ['width', 1.0, 4.0, { x: 1.5, y: 0, z: 0 }]],

    ['cylinder', 'cylinder',
        ['radius', 'height', 'capped', 'axis', 'posX', 'posY', 'posZ'],
        ['height', 4.0],
        ['radius', 0.5, 2.0, { x: 1.2, y: 0, z: 0 }]],

    ['capsule', 'capsule',
        // Fix applied: user-friendly height+position, not raw ax/bx endpoints
        ['radius', 'height', 'posX', 'posY', 'posZ'],
        ['height', 4.0],
        ['radius', 0.3, 1.5, { x: 0, y: 0, z: 0 }]],

    ['torus', 'torus',
        ['majorRadius', 'minorRadius', 'posX', 'posY', 'posZ'],
        ['majorRadius', 3.0],
        ['majorRadius', 1.0, 3.0, { x: 1.5, y: 0, z: 0 }]],

    ['cone', 'cone',
        ['radius', 'height', 'axis', 'posX', 'posY', 'posZ'],
        ['height', 4.0],
        ['radius', 0.5, 2.0, { x: 1.2, y: 0, z: 0 }]],

    ['plane', 'plane',
        // nx/ny/nz/offset — not normalX/Y/Z/d
        ['nx', 'ny', 'nz', 'offset'],
        ['offset', 2.0],
        ['offset', 0.0, 3.0, { x: 0, y: 2.0, z: 0 }]],
