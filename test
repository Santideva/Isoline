// SECTION 8 — Parameter Visibility Audit (Coda)
//
// Classifies every suspicious parameter as:
//   STRONG     — max grid SDF diff ≥ 0.5    (clearly visible, definitely wired)
//   MODERATE   — max grid SDF diff 0.05–0.5  (visible, meaningful)
//   SUBTLE     — max grid SDF diff 0.001–0.05 (present but may be imperceptible)
//   DEAD       — max grid SDF diff < 0.001   (param has no effect on output)
//
// Also tests:
//   CONDITIONAL — params active only when another param has a specific value
//   PIPELINE    — whether effect survives into ray march mode
// ══════════════════════════════════════════════════════════════════════════════
section('Section 8 — Parameter Visibility Audit (Coda)');

// ── Grid probe ────────────────────────────────────────────────────────────────
// Sample SDF on an N×N grid over [-range,range]² and return the flat array.
function probeGrid(sdfFn, N = 5, range = 3) {
    const vals = [];
    for (let i = 0; i < N; i++) {
        for (let j = 0; j < N; j++) {
            const x = (i / (N - 1) - 0.5) * 2 * range;
            const y = (j / (N - 1) - 0.5) * 2 * range;
            try   { const v = sdfFn({ x, y, z: 0 }); vals.push(isFinite(v) ? v : 0); }
            catch (_) { vals.push(0); }
        }
    }
    return vals;
}
function gridMaxDiff(a, b) {
    return a.reduce((m, v, i) => Math.max(m, Math.abs(v - (b[i] ?? 0))), 0);
}
function diffLabel(d) {
    if (d < 0)      return '❓ EVAL ERR';
    if (d < 0.001)  return '⬛ DEAD';
    if (d < 0.05)   return '🟡 SUBTLE';
    if (d < 0.5)    return '🟠 MODERATE';
    return                 '🟢 STRONG';
}

// Run CPU diff for a wired scene; nodeId must already be wired to output.
function cpuDiff(nodeId, paramName, v0, v1) {
    graph().updateNodeParam(nodeId, paramName, v0);
    sm.evaluator.graph = graph(); sm.evaluator.invalidate();
    let f0 = null; try { f0 = sm.evaluator.getRootSDF(); } catch (_) {}
    const g0 = f0 ? probeGrid(f0) : null;

    graph().updateNodeParam(nodeId, paramName, v1);
    sm.evaluator.graph = graph(); sm.evaluator.invalidate();
    let f1 = null; try { f1 = sm.evaluator.getRootSDF(); } catch (_) {}
    const g1 = f1 ? probeGrid(f1) : null;

    return (g0 && g1) ? gridMaxDiff(g0, g1) : -1;
}

// Run GLSL diff; scene must already be wired and renderMode must be 'glsl'.
async function glslDiff(nodeId, paramName, v0, v1) {
    graph().updateNodeParam(nodeId, paramName, v0);
    sm._lastGLSLSource = null; sm._renderGLSL(); await wait(250);
    const s0 = sm._lastGLSLSource;

    graph().updateNodeParam(nodeId, paramName, v1);
    nc._onParamChange(nodeId, paramName, v1);
    sm._lastGLSLSource = null; sm._renderGLSL(); await wait(250);
    const s1 = sm._lastGLSLSource;

    if (!s0 || !s1) return 'COMPILE_FAIL';
    return s0 !== s1 ? 'CHANGED' : 'IDENTICAL';
}

const auditRows = [];
function reportAudit(label, paramName, v0, v1, cpuD, glslResult) {
    const cpuStatus  = diffLabel(cpuD);
    const glslStatus = glslResult === 'CHANGED'      ? '🟢 LIVE'
                     : glslResult === 'IDENTICAL'    ? '⬛ DEAD (possibly uniform/hardcoded)'
                     : '❓ COMPILE FAIL';
    auditRows.push({ label, paramName, [`v0→v1`]: `${v0}→${v1}`, cpuStatus, glslStatus });
    console.log(`  [audit] ${label} | "${paramName}" ${v0}→${v1} | CPU: ${cpuStatus} | GLSL: ${glslStatus}`);
}

