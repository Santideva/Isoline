for (const [addType, nodeType, expectedKeys, [updateParam, updateVal], [sdfParam, v0, v1, probe]]
    of PRIMS_3D) {
    clearScene();
    sm.addPrimitive(addType);
    await wait(80);
    const node = findNode(n => n.type === nodeType);
    checkParams(addType, node, expectedKeys);
    if (node) {
        checkParamUpdate(addType, node.id, updateParam, updateVal);
        clearScene();
        sm.addPrimitive(addType);
        await wait(60);
        const node2 = findNode(n => n.type === nodeType);
        if (node2) {
            const sdf = wireAndGetSDF(node2.id, 'sdf');
            if (sdf) checkSDFChanges(addType, node2.id, sdfParam, v0, v1, probe);
            else check(`[${addType}] SDF obtainable`, false, 'getRootSDF returned null');
        }
