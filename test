}

sectionEnd();

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 3 — Transform Node Parameters
//
// For each transform:
//   (a) All expected param keys exist in node.params
//   (b) Key param update persists and clears GLSL cache
//   (c) Changing the key param produces a different compiled GLSL shader source
//       — this confirms the param value is embedded in generated code and is
//       not silently ignored by the evaluator
// ══════════════════════════════════════════════════════════════════════════════
section('Section 3 — Transform Node Parameters (with GLSL usability verification)');

const TRANSFORMS = [
    // [dispatch, nodeType, expectedKeys, [updateParam, newVal], [glslParam, v0, v1]]
    //   updateParam: checked for persistence + cache invalidation
    //   glslParam:   checked by comparing compiled GLSL source before/after change
    ['extrude', 'extrudeNode',
        ['height'],
        ['height', 5.0],
        ['height', 1.0, 5.0]],

    ['revolve', 'revolveNode',
        ['offset'],
        ['offset', 0.5],
        ['offset', 0.0, 1.5]],

    ['tiling', 'tilingNode',
        ['lattice', 'periodX', 'periodY', 'offsetX', 'offsetY', 'isoOffset'],
        ['periodX', 4.0],
        ['periodX', 2.0, 6.0]],

    ['symmetryfold', 'symmetryFoldNode',
        ['folds', 'centerX', 'centerY', 'rotation', 'reflectX', 'reflectY'],
        ['folds', 4],
        ['folds', 3, 8]],

    ['symmetryorbit', 'symmetryOrbitNode',
        ['folds', 'centerX', 'centerY', 'rotation', 'reflectX', 'combiner', 'smoothness'],
        ['smoothness', 12],
        ['folds', 3, 9]],   // smoothness only active when combiner≠'min' — audited in Section 8

    ['mobius', 'mobiusNode',
        ['aRe', 'aIm', 'bRe', 'bIm', 'cRe', 'cIm', 'dRe', 'dIm'],
        ['aRe', 2.0],
        ['aRe', 1.0, 3.0]],

    ['noisedisplace', 'noiseDisplaceNode',
        ['amplitude', 'frequency', 'animated'],
        ['amplitude', 0.6],
        ['amplitude', 0.1, 0.8]],

    ['twist', 'twistNode',
        ['strength'],
        ['strength', 2.5],
        ['strength', 0.5, 3.0]],

    ['bend', 'bendNode',
        ['strength'],
        ['strength', 1.2],
        ['strength', 0.2, 2.0]],

    ['repeat', 'repeatNode',
        ['countX', 'countY', 'countZ', 'spacingX', 'spacingY', 'spacingZ'],
        ['spacingX', 4.0],
        ['spacingX', 2.0, 6.0]],
];

for (const [dispatch, nodeType, expectedKeys, [updateParam, updateVal], [glslParam, gv0, gv1]]
    of TRANSFORMS) {

    // ── (a) + (b): param keys, persistence, cache invalidation ───────────────
    clearScene();
    sm.addPrimitive('circle');
    await wait(60);
    nc._addTransformNode(dispatch);
    await wait(80);

    const node = findNode(n => n.type === nodeType);
    checkParams(dispatch, node, expectedKeys);
    if (node) checkParamUpdate(dispatch, node.id, updateParam, updateVal);

    // ── (c): changing glslParam alters compiled GLSL source ──────────────────
    // Build a fresh wired scene: circle → transform → output
    clearScene();
    sm.addPrimitive('circle');
    await wait(60);
    nc._addTransformNode(dispatch);
    await wait(80);

    const xNode = findNode(n => n.type === nodeType);
    if (!xNode) {
        check(`[${dispatch}] node available for GLSL test`, false);
        continue;
    }

    // Ensure the scene is wired to the output so _graphIsRenderable() returns true
    const outN = sm._ensureOutputNode();
    const incomingEdges = graph().getAllIncomingEdges?.(outN.id, 'sdf') ?? [];
    if (incomingEdges.length === 0) {
        // Auto-wiring didn't reach output — wire manually
        wire(xNode.id, 'result', outN.id, 'sdf');
    }

    sm.setRenderMode('glsl');
    await checkGLSLSourceChanges(dispatch, xNode.id, glslParam, gv0, gv1);
}

sectionEnd();

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 4 — Blend Node Parameters
//
// For each blend:
//   (a) All expected param keys exist in node.params
//   (b) Key param update persists and clears GLSL cache
//   (c) Changing smoothness produces a different compiled GLSL source
//   (d) Changing smoothness alters the CPU SDF value at the blend boundary
//       — dual verification confirms the param is live end-to-end
//
// Geometry for (c) and (d):
//   Circle A at posX=-0.5, radius=0.8   →  extends from x=-1.3 to x=0.3
//   Circle B at posX= 0.5, radius=0.8   →  extends from x=-0.3 to x=1.3
//   Overlap: x ∈ [-0.3, 0.3]
//   Blend boundary probe: (0.7, 0) — just outside A (dist=0.4), inside B (dist=-0.6)
//   At this probe the smooth-union value changes meaningfully with smoothness.
// ══════════════════════════════════════════════════════════════════════════════
section('Section 4 — Blend Node Parameters (with GLSL and CPU usability verification)');

const BLENDS = [
    // [type, expectedKeys, [updateParam, updateVal], [glslParam, gv0, gv1]]
    ['schurBlend',
        ['operation', 'smoothness', 'rotation', 'scale', 'posX', 'posY', 'isoOffset'],
        ['smoothness', 12],
        ['smoothness', 4, 20]],

    ['rUnion',
        ['smoothness'],
        ['smoothness', 6],
        ['smoothness', 2, 16]],

    ['rIntersection',
        ['smoothness'],
        ['smoothness', 6],
        ['smoothness', 2, 16]],

    ['rDifference',
        ['smoothness'],
        ['smoothness', 6],
        ['smoothness', 2, 16]],
];

// Helper: build the two-circle blend scene wired to output
async function buildBlendScene(type) {
    clearScene();
    sm.addPrimitive('circle');
    await wait(60);
    sm.addPrimitive('circle');
    await wait(60);

    const circles = [];
    graph().nodes.forEach(n => { if (n.type === 'circle') circles.push(n); });
    if (circles.length < 2) return null;

    graph().updateNodeParam(circles[0].id, 'posX',  -0.5);
    graph().updateNodeParam(circles[0].id, 'radius', 0.8);
    graph().updateNodeParam(circles[1].id, 'posX',   0.5);
    graph().updateNodeParam(circles[1].id, 'radius', 0.8);

    nc._addBlendNode(type);
    await wait(60);

    const blendNode  = findNode(n => n.type === type);
    const outputNode = sm._ensureOutputNode();
    if (!blendNode) return null;

    wire(circles[0].id, 'sdf',    blendNode.id,  'sdfA');
    wire(circles[1].id, 'sdf',    blendNode.id,  'sdfB');
    wire(blendNode.id,  'result', outputNode.id, 'sdf');
    await wait(60);
    return blendNode;
}

for (const [type, expectedKeys, [updateParam, updateVal], [glslParam, gv0, gv1]] of BLENDS) {

    // ── (a) + (b): param keys, persistence, cache invalidation ───────────────
    clearScene();
    nc._addBlendNode(type);
    await wait(60);
    const node = findNode(n => n.type === type);
    checkParams(type, node, expectedKeys);
    if (node) checkParamUpdate(type, node.id, updateParam, updateVal);

    // ── (c): GLSL source changes with smoothness ──────────────────────────────
    const blendForGLSL = await buildBlendScene(type);
    if (blendForGLSL) {
        sm.setRenderMode('glsl');
        await checkGLSLSourceChanges(type, blendForGLSL.id, glslParam, gv0, gv1);
    } else {
        check(`[${type}] blend scene built for GLSL test`, false, 'could not create blend scene');
    }

    // ── (d): CPU SDF value changes at blend boundary ──────────────────────────
    // Probe: (0.7, 0) — just outside A (dist≈+0.4), inside B (dist≈-0.6).
    // The smooth blend formula produces different values here for different s.
    const blendForCPU = await buildBlendScene(type);
    if (blendForCPU) {
        const probe = { x: 0.7, y: 0, z: 0 };

        graph().updateNodeParam(blendForCPU.id, glslParam, gv0);
        sm.evaluator.graph = graph(); sm.evaluator.invalidate();
        let sdf0 = null;
        try { sdf0 = sm.evaluator.getRootSDF(); } catch (_) {}
        const val0 = sdf0?.(probe);

        graph().updateNodeParam(blendForCPU.id, glslParam, gv1);
        sm.evaluator.graph = graph(); sm.evaluator.invalidate();
        let sdf1 = null;
        try { sdf1 = sm.evaluator.getRootSDF(); } catch (_) {}
        const val1 = sdf1?.(probe);

        check(
            `[${type}] smoothness change alters CPU SDF at blend boundary (CPU usability)`,
            isFinite(val0) && isFinite(val1) && Math.abs(val1 - val0) > 1e-6,
            `s=${gv0} → sdf=${val0?.toFixed(4)}   s=${gv1} → sdf=${val1?.toFixed(4)}`
        );
    } else {
        check(`[${type}] blend scene built for CPU test`, false, 'could not create blend scene');
    }
}

sectionEnd();

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 5 — End-to-end: param change propagates through CPU and GLSL pipelines
// ══════════════════════════════════════════════════════════════════════════════
section('Section 5 — End-to-end param → render pipeline (circle)');

clearScene();
sm.addPrimitive('circle');
await wait(100);

const e2eCircle = findNode(n => n.type === 'circle');
const e2eOutput = sm._ensureOutputNode();

if (e2eCircle && e2eOutput) {
    try { graph().addEdge(e2eCircle.id, 'sdf', e2eOutput.id, 'sdf'); } catch (_) {}
    await wait(60);

    const probe = { x: 1.5, y: 0, z: 0 };

    graph().updateNodeParam(e2eCircle.id, 'radius', 1.0);
    sm.evaluator.graph = graph(); sm.evaluator.invalidate();
    const e2eSdfFn1 = sm.evaluator.getRootSDF?.();
    const val_r1 = e2eSdfFn1?.(probe);
    check('[e2e] radius=1: probe (1.5,0) is outside (positive SDF)',
        (val_r1 ?? -1) > 0, `val: ${val_r1?.toFixed(4)}`);

    graph().updateNodeParam(e2eCircle.id, 'radius', 2.0);
    sm.evaluator.graph = graph(); sm.evaluator.invalidate();
    const e2eSdfFn2 = sm.evaluator.getRootSDF?.();
    const val_r2 = e2eSdfFn2?.(probe);
    check('[e2e] radius=2: probe (1.5,0) is inside (negative SDF)',
        (val_r2 ?? 1) < 0, `val: ${val_r2?.toFixed(4)}`);

    check('[e2e] radius change produces distinct SDF values', val_r1 !== val_r2);

    graph().updateNodeParam(e2eCircle.id, 'radius', 1.0);
    graph().updateNodeParam(e2eCircle.id, 'posX',   0.0);
    sm.evaluator.graph = graph(); sm.evaluator.invalidate();
    const e2eSdfFnA = sm.evaluator.getRootSDF?.();
    const valA = e2eSdfFnA?.({ x: 0, y: 0, z: 0 });

    graph().updateNodeParam(e2eCircle.id, 'posX', 6.0);
    sm.evaluator.graph = graph(); sm.evaluator.invalidate();
    const e2eSdfFnB = sm.evaluator.getRootSDF?.();
    const valB = e2eSdfFnB?.({ x: 0, y: 0, z: 0 });
    check('[e2e] posX=6: origin is outside circle (positive SDF)', (valB ?? 0) > 0,
        `val: ${valB?.toFixed(4)}`);
    check('[e2e] posX change produces distinct SDF values', valA !== valB);

    graph().updateNodeParam(e2eCircle.id, 'posX', 0.0);
    graph().updateNodeParam(e2eCircle.id, 'radius', 1.0);
    sm.setRenderMode('glsl');
    sm._renderGLSL();
    await wait(350);
    check('[e2e] GLSL source generated for wired scene', !!sm._lastGLSLSource);

    const srcBefore = sm._lastGLSLSource;
    graph().updateNodeParam(e2eCircle.id, 'radius', 2.8);
    nc._onParamChange(e2eCircle.id, 'radius', 2.8);
    check('[e2e] param change clears GLSL cache', sm._lastGLSLSource === null);

    await wait(400);
    sm._renderGLSL();
    await wait(350);
    check('[e2e] GLSL recompiles after param change', !!sm._lastGLSLSource);
    check('[e2e] recompiled source differs from pre-change source',
        !!sm._lastGLSLSource && sm._lastGLSLSource !== srcBefore);
